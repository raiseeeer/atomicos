# Copy this file to .env and edit the values
APP_NAME=Atomicos
APP_ENV=local
# Path from your web root to the /public folder. Use "" if your vhost points to /public
APP_URL=/atomicos/public

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=atomicos
DB_USER=root
DB_PASS=

# Work schedule used to flag "late" in the DTR
WORK_START=08:00:00
WORK_END=17:00:00
